# ShortOrder's signing settings, for ./release.sh (and ./build-install.sh --devid, and Tools/export-public.sh's author).
# Copy this file to signing.env (gitignored: never commit it) and fill in the values. Nothing here is a password: the iLok
# password is asked for when ./release.sh runs, and the notary password lives in the keychain profile.

# The Developer ID Application identity: its full name, "Developer ID Application: <name> (<team ID>)", or its SHA-1 hash.
# List them with: security find-identity -v -p codesigning
DEVELOPER_ID_APP=""

# The Developer ID Installer identity (signs the .pkg): "Developer ID Installer: <name> (<team ID>)".
# List them with: security find-identity -v
DEVELOPER_ID_INSTALLER=""

# A notarytool keychain profile, made once with:
#   xcrun notarytool store-credentials <profile> --apple-id <Apple ID> --team-id <team ID>
# (it asks for an app-specific password and keeps it in the keychain)
NOTARY_PROFILE=""

# PACE (AAX signing): the PACE Central account, and ShortOrder's own wrap configuration GUID from PACE Central.
# Never reuse another product's GUID.
PACE_ACCOUNT=""
PACE_WCGUID=""

# Tools/export-public.sh: the author of the public repository's commit (e.g. a GitHub noreply address).
PUBLIC_AUTHOR_NAME=""
PUBLIC_AUTHOR_EMAIL=""
